[gd_resource type="Resource" script_class="DialogueDefinition" format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_mean"]
script = ExtResource("3_choice")
choice_id = &"meant_it"
text = "Tell her you meant it."
next_node_id = &"meant"

[sub_resource type="Resource" id="Choice_tease"]
script = ExtResource("3_choice")
choice_id = &"tease_gently"
text = "Tease her gently."
next_node_id = &"tease"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"npc"
speaker_text = "Y-you shouldn't say something like that so suddenly... I didn't say I disliked it."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_mean"), SubResource("Choice_tease")])

[sub_resource type="Resource" id="Node_meant"]
script = ExtResource("2_node")
node_id = &"meant"
speaker_id = &"npc"
speaker_text = "You really meant it? Then... thank you. I'll remember that."
terminal = true

[sub_resource type="Resource" id="Node_tease"]
script = ExtResource("2_node")
node_id = &"tease"
speaker_id = &"npc"
speaker_text = "Please don't tease me when my face is already this warm."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"maid_player_talk_flirt"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_meant"), SubResource("Node_tease")])
