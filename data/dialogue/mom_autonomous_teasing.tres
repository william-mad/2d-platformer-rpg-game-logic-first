[sub_resource type="Resource" id="Node_player_charming"]
script = ExtResource("2_node")
node_id = &"player_charming"
speaker_id = &"player"
speaker_text = "Did you miss me?"
next_node_id = &"mom_charming"

[sub_resource type="Resource" id="Node_mom_charming"]
script = ExtResource("2_node")
node_id = &"mom_charming"
speaker_id = &"mom"
speaker_text = "Maybe a little. Don't look so pleased with yourself."
terminal = true

[sub_resource type="Resource" id="Node_player_innocent"]
script = ExtResource("2_node")
node_id = &"player_innocent"
speaker_id = &"player"
speaker_text = "Do you need something?"
next_node_id = &"mom_innocent"

[sub_resource type="Resource" id="Node_mom_innocent"]
script = ExtResource("2_node")
node_id = &"mom_innocent"
speaker_id = &"mom"
speaker_text = "Only your company, if you can spare a minute."
terminal = true

[sub_resource type="Resource" id="Node_player_counter"]
script = ExtResource("2_node")
node_id = &"player_counter"
speaker_id = &"player"
speaker_text = "I was just passing by."
next_node_id = &"mom_counter"

[sub_resource type="Resource" id="Node_mom_counter"]
script = ExtResource("2_node")
node_id = &"mom_counter"
speaker_id = &"mom"
speaker_text = "Then I'm glad you chose this way. Stay for a moment."
terminal = true

