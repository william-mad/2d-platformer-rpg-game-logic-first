[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://c58q6wubupoc6"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_worked"]
script = ExtResource("3_choice")
choice_id = &"it_worked"
text = "Point out that it worked."
next_node_id = &"worked"

[sub_resource type="Resource" id="Choice_better"]
script = ExtResource("3_choice")
choice_id = &"can_do_better"
text = "Promise you can do better."
next_node_id = &"better"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"mom"
speaker_text = "You really know how to make me feel noticed. I like that."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_worked"), SubResource("Choice_better")])

[sub_resource type="Resource" id="Node_worked"]
script = ExtResource("2_node")
node_id = &"worked"
speaker_id = &"mom"
speaker_text = "It worked. Come here and enjoy your victory for a moment."
terminal = true

[sub_resource type="Resource" id="Node_better"]
script = ExtResource("2_node")
node_id = &"better"
speaker_id = &"mom"
speaker_text = "Then come find me when you're ready. I'll be listening."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_player_talk_flirt_line"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_worked"), SubResource("Node_better")])
