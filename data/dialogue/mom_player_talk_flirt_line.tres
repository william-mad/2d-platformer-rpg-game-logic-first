[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_worked"]
script = ExtResource("3_choice")
choice_id = &"it_worked"
text = "Point out that it worked."
next_node_id = &"worked"

[sub_resource type="Resource" id="Choice_better"]
script = ExtResource("3_choice")
choice_id = &"can_do_better"
text = "Promise you can do better."
next_node_id = &"better"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"mom"
speaker_text = "Is that your best line? Mm. A little reckless, a little obvious... and annoyingly close to charming."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_worked"), SubResource("Choice_better")])

[sub_resource type="Resource" id="Node_worked"]
script = ExtResource("2_node")
node_id = &"worked"
speaker_id = &"mom"
speaker_text = "Don't look so triumphant. I said close. Though that grin may be doing the rest of the work."
terminal = true

[sub_resource type="Resource" id="Node_better"]
script = ExtResource("2_node")
node_id = &"better"
speaker_id = &"mom"
speaker_text = "Oh? Then practice and come find me. I do appreciate dedication to a craft."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_player_talk_flirt_line"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_worked"), SubResource("Node_better")])
