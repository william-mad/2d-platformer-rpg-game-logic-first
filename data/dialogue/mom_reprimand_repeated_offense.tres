[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://ck7nfqa5o00v4"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_apologize"]
script = ExtResource("3_choice")
choice_id = &"apologize"
text = "I'm sorry. It won't happen again."
next_node_id = &"mom_apology"
consequences = {
"reprimand_outcome": &"apologize"
}

[sub_resource type="Resource" id="Choice_excuse"]
script = ExtResource("3_choice")
choice_id = &"accident_again"
text = "It was another accident."
next_node_id = &"mom_excuse"
consequences = {
"reprimand_outcome": &"excuse"
}

[sub_resource type="Resource" id="Choice_justify"]
script = ExtResource("3_choice")
choice_id = &"still_fighting"
text = "I'm trying to keep the monsters off us."
next_node_id = &"mom_justify"
consequences = {
"reprimand_outcome": &"justify"
}

[sub_resource type="Resource" id="Choice_threaten"]
script = ExtResource("3_choice")
choice_id = &"get_used_to_it"
text = "Get used to it."
next_node_id = &"mom_threaten"
consequences = {
"reprimand_outcome": &"threaten"
}

[sub_resource type="Resource" id="Node_question"]
script = ExtResource("2_node")
node_id = &"question"
speaker_id = &"mom"
speaker_text = "Again? I already asked you to be careful. What's going on?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_apologize"), SubResource("Choice_excuse"), SubResource("Choice_justify"), SubResource("Choice_threaten")])

[sub_resource type="Resource" id="Node_apology"]
script = ExtResource("2_node")
node_id = &"mom_apology"
speaker_id = &"mom"
speaker_text = "All right. I believe you. But this really cannot happen again."
terminal = true

[sub_resource type="Resource" id="Node_excuse"]
script = ExtResource("2_node")
node_id = &"mom_excuse"
speaker_id = &"mom"
speaker_text = "Then you need to slow down. Someone is going to get badly hurt."
terminal = true

[sub_resource type="Resource" id="Node_justify"]
script = ExtResource("2_node")
node_id = &"mom_justify"
speaker_id = &"mom"
speaker_text = "I know you're trying to protect us. You still have to watch where you're aiming."
terminal = true

[sub_resource type="Resource" id="Node_threaten"]
script = ExtResource("2_node")
node_id = &"mom_threaten"
speaker_id = &"mom"
speaker_text = "No. Stop. I'm not going to let you keep hurting me."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_reprimand_repeated_offense"
entry_node_id = &"question"
nodes = Array[ExtResource("2_node")]([SubResource("Node_question"), SubResource("Node_apology"), SubResource("Node_excuse"), SubResource("Node_justify"), SubResource("Node_threaten")])
