[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_help"]
script = ExtResource("3_choice")
choice_id = &"offer_to_help"
text = "Need a hand with anything?"
next_node_id = &"player_help"

[sub_resource type="Resource" id="Choice_done"]
script = ExtResource("3_choice")
choice_id = &"already_helped"
text = "I already did my part."
next_node_id = &"player_done"

[sub_resource type="Resource" id="Choice_hide"]
script = ExtResource("3_choice")
choice_id = &"strategic_retreat"
text = "I was about to become very busy."
next_node_id = &"player_hide"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"chores"
speaker_id = &"mom"
speaker_text = "I have a list, and the list has started looking back at me."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_help"), SubResource("Choice_done"), SubResource("Choice_hide")])

[sub_resource type="Resource" id="Node_player_help"]
script = ExtResource("2_node")
node_id = &"player_help"
speaker_id = &"player"
speaker_text = "Need a hand? We can make the list afraid of us instead."
next_node_id = &"mom_help"

[sub_resource type="Resource" id="Node_mom_help"]
script = ExtResource("2_node")
node_id = &"mom_help"
speaker_id = &"mom"
speaker_text = "That's the spirit. I'll save you something satisfyingly dramatic."
terminal = true

[sub_resource type="Resource" id="Node_player_done"]
script = ExtResource("2_node")
node_id = &"player_done"
speaker_id = &"player"
speaker_text = "I already handled my share. You may inspect the evidence."
next_node_id = &"mom_done"

[sub_resource type="Resource" id="Node_mom_done"]
script = ExtResource("2_node")
node_id = &"mom_done"
speaker_id = &"mom"
speaker_text = "Proactive and confident. Should I be proud or suspicious?"
terminal = true

[sub_resource type="Resource" id="Node_player_hide"]
script = ExtResource("2_node")
node_id = &"player_hide"
speaker_id = &"player"
speaker_text = "Fascinating. I suddenly remembered some urgent, distant business."
next_node_id = &"mom_hide"

[sub_resource type="Resource" id="Node_mom_hide"]
script = ExtResource("2_node")
node_id = &"mom_hide"
speaker_id = &"mom"
speaker_text = "Run if you like. The list knows where you sleep."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_autonomous_chores"
entry_node_id = &"chores"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_player_help"), SubResource("Node_mom_help"), SubResource("Node_player_done"), SubResource("Node_mom_done"), SubResource("Node_player_hide"), SubResource("Node_mom_hide")])
