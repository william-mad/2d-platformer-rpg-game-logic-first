[sub_resource type="Resource" id="Choice_done"]
script = ExtResource("3_choice")
choice_id = &"already_helped"
text = "I already did my part."
next_node_id = &"player_done"

[sub_resource type="Resource" id="Choice_hide"]
script = ExtResource("3_choice")
choice_id = &"strategic_retreat"
text = "Can it wait until later?"
next_node_id = &"player_hide"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"chores"
speaker_id = &"mom"
speaker_text = "I still have a few things to finish around the house. Have you done what you needed to do?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_help"), SubResource("Choice_done"), SubResource("Choice_hide")])

[sub_resource type="Resource" id="Node_player_help"]
script = ExtResource("2_node")
node_id = &"player_help"
speaker_id = &"player"
speaker_text = "Do you need a hand with anything?"
next_node_id = &"mom_help"

[sub_resource type="Resource" id="Node_mom_help"]
script = ExtResource("2_node")
node_id = &"mom_help"
speaker_id = &"mom"
speaker_text = "Thank you. A little help would make the work go much faster."
terminal = true

[sub_resource type="Resource" id="Node_player_done"]
script = ExtResource("2_node")
node_id = &"player_done"
speaker_id = &"player"
speaker_text = "I already finished my part."
next_node_id = &"mom_done"

[sub_resource type="Resource" id="Node_mom_done"]
script = ExtResource("2_node")
node_id = &"mom_done"
speaker_id = &"mom"
speaker_text = "Good. Thank you for taking care of it without being asked."
terminal = true

[sub_resource type="Resource" id="Node_player_hide"]
script = ExtResource("2_node")
node_id = &"player_hide"
speaker_id = &"player"
speaker_text = "Can it wait until later?"
next_node_id = &"mom_hide"

[sub_resource type="Resource" id="Node_mom_hide"]
script = ExtResource("2_node")
node_id = &"mom_hide"
speaker_id = &"mom"
speaker_text = "For a little while. Just don't leave everything until the end of the day."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_autonomous_chores"
entry_node_id = &"chores"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_player_help"), SubResource("Node_mom_help"), SubResource("Node_player_done"), SubResource("Node_mom_done"), SubResource("Node_player_hide"), SubResource("Node_mom_hide")])
