[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://8wvkn33ubkf1"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_apologize"]
script = ExtResource("3_choice")
choice_id = &"apologize"
text = "Back down and apologize."
next_node_id = &"apology"

[sub_resource type="Resource" id="Choice_double"]
script = ExtResource("3_choice")
choice_id = &"double_down"
text = "Double down."
next_node_id = &"double"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"mom"
speaker_text = "That was unnecessary. Is something wrong, or are you just trying to upset me?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_apologize"), SubResource("Choice_double")])

[sub_resource type="Resource" id="Node_apology"]
script = ExtResource("2_node")
node_id = &"apology"
speaker_id = &"mom"
speaker_text = "Thank you for apologizing. Let's leave it there."
terminal = true

[sub_resource type="Resource" id="Node_double"]
script = ExtResource("2_node")
node_id = &"double"
speaker_id = &"mom"
speaker_text = "Then give me some space until you're ready to speak respectfully."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_player_talk_insult_brave"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_apology"), SubResource("Node_double")])
