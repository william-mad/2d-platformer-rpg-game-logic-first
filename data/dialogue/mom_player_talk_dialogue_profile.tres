[gd_resource type="Resource" script_class="NpcPlayerTalkDialogueProfile" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/npc_player_talk_dialogue_profile.gd" id="1_profile"]
