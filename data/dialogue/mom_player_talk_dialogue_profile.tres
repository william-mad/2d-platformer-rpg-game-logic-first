[resource]
script = ExtResource("1_profile")
speaker_id = &"mom"
speaker_name = "Mom"
dialogue_gender = "female"
player_speaker_id = &"player"
player_speaker_name = "Player"
portrait = ExtResource("2_portrait")
portrait_animation = ExtResource("19_portrait_animation")
casual_responses = Array[ExtResource("3_casual_a")]([ExtResource("3_casual_a"), ExtResource("4_casual_b")])
compliment_responses = Array[ExtResource("5_compliment_a")]([ExtResource("5_compliment_a"), ExtResource("6_compliment_b")])
flirt_responses = Array[ExtResource("7_flirt_a")]([ExtResource("7_flirt_a"), ExtResource("8_flirt_b")])
insult_responses = Array[ExtResource("9_insult_a")]([ExtResource("9_insult_a"), ExtResource("10_insult_b")])
gossip_responses = Array[ExtResource("11_gossip_a")]([ExtResource("11_gossip_a"), ExtResource("12_gossip_b")])
reprimand_responses = {
"attacked_friend": [ExtResource("16_reprimand_friend")],
"attacked_me": [ExtResource("13_reprimand_hit_a"), ExtResource("14_reprimand_hit_b")],
"false_monster_alarm": [ExtResource("17_false_alarm_a"), ExtResource("18_false_alarm_b")],
"repeated_offense": [ExtResource("15_reprimand_repeat")]
}
