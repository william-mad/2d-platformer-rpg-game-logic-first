[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_compliment_sweet.tres" id="5_compliment_a"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_compliment_notice.tres" id="6_compliment_b"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_flirt_line.tres" id="7_flirt_a"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_flirt_chores.tres" id="8_flirt_b"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_insult_brave.tres" id="9_insult_a"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_insult_attention.tres" id="10_insult_b"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_gossip_chore.tres" id="11_gossip_a"]
[ext_resource type="Resource" path="res://data/dialogue/mom_player_talk_gossip_kindness.tres" id="12_gossip_b"]
[ext_resource type="Resource" path="res://data/dialogue/mom_reprimand_attacked_me_watch_it.tres" id="13_reprimand_hit_a"]
[ext_resource type="Resource" path="res://data/dialogue/mom_reprimand_attacked_me_slime.tres" id="14_reprimand_hit_b"]
[ext_resource type="Resource" path="res://data/dialogue/mom_reprimand_repeated_offense.tres" id="15_reprimand_repeat"]
[ext_resource type="Resource" path="res://data/dialogue/mom_reprimand_attacked_friend.tres" id="16_reprimand_friend"]
[ext_resource type="Resource" path="res://data/dialogue/mom_reprimand_false_monster_alarm_running.tres" id="17_false_alarm_a"]
[ext_resource type="Resource" path="res://data/dialogue/mom_reprimand_false_monster_alarm_empty.tres" id="18_false_alarm_b"]
