[gd_resource type="Resource" script_class="DialogueDefinition" format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_best"]
script = ExtResource("3_choice")
choice_id = &"best"
text = "Offer your hand and let her decide both pace and distance."
next_node_id = &"reply_best"
consequences = {
"player_talk_opinion_delta": {
"love": 2.0
}
}

[sub_resource type="Resource" id="Choice_warm"]
script = ExtResource("3_choice")
choice_id = &"warm"
text = "Ask for one slow dance."
next_node_id = &"reply_warm"
consequences = {
"player_talk_opinion_delta": {
"love": 1.0
}
}

[sub_resource type="Resource" id="Choice_neutral"]
script = ExtResource("3_choice")
choice_id = &"neutral"
text = "Offer to listen beside her instead."
next_node_id = &"reply_neutral"
consequences = {
"player_talk_opinion_delta": {
"love": 0.0
}
}

[sub_resource type="Resource" id="Choice_bad"]
script = ExtResource("3_choice")
choice_id = &"bad"
text = "Spin her around before she answers."
next_node_id = &"reply_bad"
consequences = {
"player_talk_opinion_delta": {
"love": -1.0
}
}

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"mom"
speaker_text = "That slow piano song is playing again."
next_node_id = &"setup_2"

[sub_resource type="Resource" id="Node_setup_2"]
script = ExtResource("2_node")
node_id = &"setup_2"
speaker_id = &"mom"
speaker_text = "Last time I said I do not usually dance."
next_node_id = &"question"

[sub_resource type="Resource" id="Node_question"]
script = ExtResource("2_node")
node_id = &"question"
speaker_id = &"mom"
speaker_text = "Usually is not the same as never."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_best"), SubResource("Choice_warm"), SubResource("Choice_neutral"), SubResource("Choice_bad")])

[sub_resource type="Resource" id="Node_reply_best"]
script = ExtResource("2_node")
node_id = &"reply_best"
speaker_id = &"mom"
speaker_text = "That invitation is very difficult to refuse."
terminal = true

[sub_resource type="Resource" id="Node_reply_warm"]
script = ExtResource("2_node")
node_id = &"reply_warm"
speaker_id = &"mom"
speaker_text = "One dance. Stay close enough to follow, not to presume."
terminal = true

[sub_resource type="Resource" id="Node_reply_neutral"]
script = ExtResource("2_node")
node_id = &"reply_neutral"
speaker_id = &"mom"
speaker_text = "Gentle. I may still hold out my hand."
terminal = true

[sub_resource type="Resource" id="Node_reply_bad"]
script = ExtResource("2_node")
node_id = &"reply_bad"
speaker_id = &"mom"
speaker_text = "You managed to turn an invitation into an escape route."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_flirt_51_60_v2"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_setup_2"), SubResource("Node_question"), SubResource("Node_reply_best"), SubResource("Node_reply_warm"), SubResource("Node_reply_neutral"), SubResource("Node_reply_bad")])
