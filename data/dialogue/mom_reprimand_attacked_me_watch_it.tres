[sub_resource type="Resource" id="Node_warning"]
script = ExtResource("2_node")
node_id = &"warning"
speaker_id = &"mom"
speaker_text = "Hey! Watch where you're swinging that thing."
next_node_id = &"question"

[sub_resource type="Resource" id="Choice_apologize"]
script = ExtResource("3_choice")
choice_id = &"apologize"
text = "Sorry."
next_node_id = &"mom_apology"
consequences = {
"reprimand_outcome": &"apologize"
}

[sub_resource type="Resource" id="Choice_excuse"]
script = ExtResource("3_choice")
choice_id = &"did_not_see"
text = "I didn't see you there."
next_node_id = &"mom_excuse"
consequences = {
"reprimand_outcome": &"excuse"
}

[sub_resource type="Resource" id="Choice_justify"]
script = ExtResource("3_choice")
choice_id = &"aimed_at_slime"
text = "I was trying to hit the slime."
next_node_id = &"mom_justify"
consequences = {
"reprimand_outcome": &"justify"
}

[sub_resource type="Resource" id="Choice_defiant"]
script = ExtResource("3_choice")
choice_id = &"move_next_time"
text = "Then move next time."
next_node_id = &"mom_defiant"
consequences = {
"reprimand_outcome": &"defiant"
}

[sub_resource type="Resource" id="Node_question"]
script = ExtResource("2_node")
node_id = &"question"
speaker_id = &"mom"
speaker_text = "Why did you hit me?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_apologize"), SubResource("Choice_excuse"), SubResource("Choice_justify"), SubResource("Choice_defiant")])

[sub_resource type="Resource" id="Node_apology"]
script = ExtResource("2_node")
node_id = &"mom_apology"
speaker_id = &"mom"
speaker_text = "Okay. I know it was an accident. Just be careful, all right?"
terminal = true

[sub_resource type="Resource" id="Node_excuse"]
script = ExtResource("2_node")
node_id = &"mom_excuse"
speaker_id = &"mom"
speaker_text = "Then slow down and look before you swing. I don't want either of us getting hurt."
terminal = true

[sub_resource type="Resource" id="Node_justify"]
script = ExtResource("2_node")
node_id = &"mom_justify"
speaker_id = &"mom"
speaker_text = "I know you were aiming for the slime. Just make sure I'm clear first."
terminal = true

[sub_resource type="Resource" id="Node_defiant"]
script = ExtResource("2_node")
node_id = &"mom_defiant"
speaker_id = &"mom"
speaker_text = "That's not okay. Put the weapon down before this gets worse."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_reprimand_attacked_me_watch_it"
entry_node_id = &"warning"
nodes = Array[ExtResource("2_node")]([SubResource("Node_warning"), SubResource("Node_question"), SubResource("Node_apology"), SubResource("Node_excuse"), SubResource("Node_justify"), SubResource("Node_defiant")])
