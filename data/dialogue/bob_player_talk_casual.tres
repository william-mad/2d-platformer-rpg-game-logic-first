[gd_resource type="Resource" script_class="DialogueDefinition" format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_quiet"]
script = ExtResource("3_choice")
choice_id = &"quiet_is_good"
text = "Say a quiet day is good."
next_node_id = &"quiet"

[sub_resource type="Resource" id="Choice_news"]
script = ExtResource("3_choice")
choice_id = &"ask_for_news"
text = "Ask if there is any news."
next_node_id = &"news"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"npc"
speaker_text = "Town's been quiet. The tavern hasn't, but that's another matter."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_quiet"), SubResource("Choice_news")])

[sub_resource type="Resource" id="Node_quiet"]
script = ExtResource("2_node")
node_id = &"quiet"
speaker_id = &"npc"
speaker_text = "Exactly. Quiet streets, a full mug, and nobody asking me to lift anything heavy."
terminal = true

[sub_resource type="Resource" id="Node_news"]
script = ExtResource("2_node")
node_id = &"news"
speaker_id = &"npc"
speaker_text = "Nothing reliable. Give any story in this town two drinks and it grows another ending."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"bob_player_talk_casual"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_quiet"), SubResource("Node_news")])
