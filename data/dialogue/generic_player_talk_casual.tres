[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_good"]
script = ExtResource("3_choice")
choice_id = &"good_to_hear"
text = "Good to hear."
next_node_id = &"good"

[sub_resource type="Resource" id="Choice_more"]
script = ExtResource("3_choice")
choice_id = &"tell_me_more"
text = "Tell me more."
next_node_id = &"more"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"npc"
speaker_text = "Nothing dramatic today. Honestly, a quiet minute with you is rather nice."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_good"), SubResource("Choice_more")])

[sub_resource type="Resource" id="Node_good"]
script = ExtResource("2_node")
node_id = &"good"
speaker_id = &"npc"
speaker_text = "Don't sound so surprised. I can be pleasant when the mood takes me."
terminal = true

[sub_resource type="Resource" id="Node_more"]
script = ExtResource("2_node")
node_id = &"more"
speaker_id = &"npc"
speaker_text = "Maybe later. For now, I'm enjoying not having a crisis to report."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"generic_player_talk_casual"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_good"), SubResource("Node_more")])
