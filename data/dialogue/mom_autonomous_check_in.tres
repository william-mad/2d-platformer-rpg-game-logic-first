[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_okay"]
script = ExtResource("3_choice")
choice_id = &"okay_just_thinking"
text = "I'm okay. Just thinking."
next_node_id = &"player_okay"

[sub_resource type="Resource" id="Choice_overwhelmed"]
script = ExtResource("3_choice")
choice_id = &"a_little_overwhelmed"
text = "A little overwhelmed, honestly."
next_node_id = &"player_overwhelmed"

[sub_resource type="Resource" id="Choice_suspicious"]
script = ExtResource("3_choice")
choice_id = &"why_do_you_ask"
text = "Why? Am I making a face?"
next_node_id = &"player_suspicious"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"check_in"
speaker_id = &"mom"
speaker_text = "You've gone quiet in that very specific way. How are you, really?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_okay"), SubResource("Choice_overwhelmed"), SubResource("Choice_suspicious")])

[sub_resource type="Resource" id="Node_player_okay"]
script = ExtResource("2_node")
node_id = &"player_okay"
speaker_id = &"player"
speaker_text = "I'm okay. My thoughts are just being louder than the room."
next_node_id = &"mom_okay"

[sub_resource type="Resource" id="Node_mom_okay"]
script = ExtResource("2_node")
node_id = &"mom_okay"
speaker_id = &"mom"
speaker_text = "All right. If they start shouting, you know where to find me."
terminal = true

[sub_resource type="Resource" id="Node_player_overwhelmed"]
script = ExtResource("2_node")
node_id = &"player_overwhelmed"
speaker_id = &"player"
speaker_text = "A little overwhelmed. Nothing is on fire, but everything feels noisy."
next_node_id = &"mom_overwhelmed"

[sub_resource type="Resource" id="Node_mom_overwhelmed"]
script = ExtResource("2_node")
node_id = &"mom_overwhelmed"
speaker_id = &"mom"
speaker_text = "Then we take it one small thing at a time. No heroics required."
terminal = true

[sub_resource type="Resource" id="Node_player_suspicious"]
script = ExtResource("2_node")
node_id = &"player_suspicious"
speaker_id = &"player"
speaker_text = "Why do you ask? Am I making a face again?"
next_node_id = &"mom_suspicious"

[sub_resource type="Resource" id="Node_mom_suspicious"]
script = ExtResource("2_node")
node_id = &"mom_suspicious"
speaker_id = &"mom"
speaker_text = "The face, the sigh, the dramatic stare into nowhere... subtle as thunder."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_autonomous_check_in"
entry_node_id = &"check_in"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_player_okay"), SubResource("Node_mom_okay"), SubResource("Node_player_overwhelmed"), SubResource("Node_mom_overwhelmed"), SubResource("Node_player_suspicious"), SubResource("Node_mom_suspicious")])
