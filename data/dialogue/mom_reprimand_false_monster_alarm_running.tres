[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://c7ya116x7sqnk"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Node_warning"]
script = ExtResource("2_node")
node_id = &"warning"
speaker_id = &"mom"
speaker_text = "That bell means there is a monster nearby. I came as quickly as I could."
next_node_id = &"question"

[sub_resource type="Resource" id="Choice_apologize"]
script = ExtResource("3_choice")
choice_id = &"false_alarm_apologize"
text = "Sorry. I wanted to see if it worked."
next_node_id = &"mom_apology"
consequences = {
"reprimand_outcome": &"apologize"
}

[sub_resource type="Resource" id="Choice_excuse"]
script = ExtResource("3_choice")
choice_id = &"false_alarm_excuse"
text = "I thought I saw a monster."
next_node_id = &"mom_excuse"
consequences = {
"reprimand_outcome": &"excuse"
}

[sub_resource type="Resource" id="Choice_justify"]
script = ExtResource("3_choice")
choice_id = &"false_alarm_drill"
text = "Call it an emergency drill."
next_node_id = &"mom_justify"
consequences = {
"reprimand_outcome": &"justify"
}

[sub_resource type="Resource" id="Node_question"]
script = ExtResource("2_node")
node_id = &"question"
speaker_id = &"mom"
speaker_text = "Why did you ring it when the yard is empty?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_apologize"), SubResource("Choice_excuse"), SubResource("Choice_justify")])

[sub_resource type="Resource" id="Node_apology"]
script = ExtResource("2_node")
node_id = &"mom_apology"
speaker_id = &"mom"
speaker_text = "Now you know it works. Don't ring it again unless there is a real emergency."
terminal = true

[sub_resource type="Resource" id="Node_excuse"]
script = ExtResource("2_node")
node_id = &"mom_excuse"
speaker_id = &"mom"
speaker_text = "I understand. Look carefully before you call everyone next time."
terminal = true

[sub_resource type="Resource" id="Node_justify"]
script = ExtResource("2_node")
node_id = &"mom_justify"
speaker_id = &"mom"
speaker_text = "A drill needs to be announced first. You frightened everyone."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_reprimand_false_monster_alarm_running"
entry_node_id = &"warning"
nodes = Array[ExtResource("2_node")]([SubResource("Node_warning"), SubResource("Node_question"), SubResource("Node_apology"), SubResource("Node_excuse"), SubResource("Node_justify")])
