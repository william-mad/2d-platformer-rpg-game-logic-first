[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://4y1k0ajj3wae"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_good"]
script = ExtResource("3_choice")
choice_id = &"day_was_good"
text = "Better than expected."
next_node_id = &"player_good"

[sub_resource type="Resource" id="Choice_strange"]
script = ExtResource("3_choice")
choice_id = &"day_was_strange"
text = "Strange, but interesting."
next_node_id = &"player_strange"

[sub_resource type="Resource" id="Choice_long"]
script = ExtResource("3_choice")
choice_id = &"day_was_long"
text = "Long. Very long."
next_node_id = &"player_long"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"day_check"
speaker_id = &"mom"
speaker_text = "How has your day been?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_good"), SubResource("Choice_strange"), SubResource("Choice_long")])

[sub_resource type="Resource" id="Node_player_good"]
script = ExtResource("2_node")
node_id = &"player_good"
speaker_id = &"player"
speaker_text = "Better than I expected."
next_node_id = &"mom_good"

[sub_resource type="Resource" id="Node_mom_good"]
script = ExtResource("2_node")
node_id = &"mom_good"
speaker_id = &"mom"
speaker_text = "I'm glad. It's nice when a day goes better than planned."
terminal = true

[sub_resource type="Resource" id="Node_player_strange"]
script = ExtResource("2_node")
node_id = &"player_strange"
speaker_id = &"player"
speaker_text = "Strange, but interesting."
next_node_id = &"mom_strange"

[sub_resource type="Resource" id="Node_mom_strange"]
script = ExtResource("2_node")
node_id = &"mom_strange"
speaker_id = &"mom"
speaker_text = "Interesting is not always bad. You can tell me about it later if you want."
terminal = true

[sub_resource type="Resource" id="Node_player_long"]
script = ExtResource("2_node")
node_id = &"player_long"
speaker_id = &"player"
speaker_text = "Long. Very long."
next_node_id = &"mom_long"

[sub_resource type="Resource" id="Node_mom_long"]
script = ExtResource("2_node")
node_id = &"mom_long"
speaker_id = &"mom"
speaker_text = "Then take it easy tonight. You have done enough for one day."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_autonomous_day"
entry_node_id = &"day_check"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_player_good"), SubResource("Node_mom_good"), SubResource("Node_player_strange"), SubResource("Node_mom_strange"), SubResource("Node_player_long"), SubResource("Node_mom_long")])
