[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_cozy"]
script = ExtResource("3_choice")
choice_id = &"house_is_cozy"
text = "It feels cozy."
next_node_id = &"player_cozy"

[sub_resource type="Resource" id="Choice_creaky"]
script = ExtResource("3_choice")
choice_id = &"house_is_creaky"
text = "It has a lot of opinions."
next_node_id = &"player_creaky"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"house_comment"
speaker_id = &"mom"
speaker_text = "This house sounds different every day. Cozy, or plotting against us?"
choices = Array[ExtResource("3_choice")]([SubResource("Choice_cozy"), SubResource("Choice_creaky")])

[sub_resource type="Resource" id="Node_player_cozy"]
script = ExtResource("2_node")
node_id = &"player_cozy"
speaker_id = &"player"
speaker_text = "Cozy. The creaks make it feel lived in."
next_node_id = &"mom_cozy"

[sub_resource type="Resource" id="Node_mom_cozy"]
script = ExtResource("2_node")
node_id = &"mom_cozy"
speaker_id = &"mom"
speaker_text = "Good answer. The house may let you keep your room."
terminal = true

[sub_resource type="Resource" id="Node_player_creaky"]
script = ExtResource("2_node")
node_id = &"player_creaky"
speaker_id = &"player"
speaker_text = "Plotting. That floorboard definitely knows something."
next_node_id = &"mom_creaky"

[sub_resource type="Resource" id="Node_mom_creaky"]
script = ExtResource("2_node")
node_id = &"mom_creaky"
speaker_id = &"mom"
speaker_text = "I knew it. We'll interrogate it after tea."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_autonomous_house"
entry_node_id = &"house_comment"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_player_cozy"), SubResource("Node_mom_cozy"), SubResource("Node_player_creaky"), SubResource("Node_mom_creaky")])
