[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://bqr3jm6u2ilwt"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_mean"]
script = ExtResource("3_choice")
choice_id = &"meant_it"
text = "Insist you meant it."
next_node_id = &"meant"

[sub_resource type="Resource" id="Choice_tease"]
script = ExtResource("3_choice")
choice_id = &"dont_get_used_to_it"
text = "Tell her not to get used to it."
next_node_id = &"tease"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"mom"
speaker_text = "That was sweet of you. Thank you."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_mean"), SubResource("Choice_tease")])

[sub_resource type="Resource" id="Node_meant"]
script = ExtResource("2_node")
node_id = &"meant"
speaker_id = &"mom"
speaker_text = "I believe you. It means a lot to hear that."
terminal = true

[sub_resource type="Resource" id="Node_tease"]
script = ExtResource("2_node")
node_id = &"tease"
speaker_id = &"mom"
speaker_text = "All right, I won't expect it every day. But I appreciated it."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_player_talk_compliment_sweet"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_meant"), SubResource("Node_tease")])
