[gd_resource type="Resource" script_class="DialogueDefinition" format=3]

[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_work"]
script = ExtResource("3_choice")
choice_id = &"ask_about_work"
text = "Ask about his last hunt."
next_node_id = &"work"

[sub_resource type="Resource" id="Choice_help"]
script = ExtResource("3_choice")
choice_id = &"offer_help"
text = "Offer to help."
next_node_id = &"help"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"npc"
speaker_text = "I've been cleaning my gear. The last monster left claw marks through two layers of leather."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_work"), SubResource("Choice_help")])

[sub_resource type="Resource" id="Node_work"]
script = ExtResource("2_node")
node_id = &"work"
speaker_id = &"npc"
speaker_text = "A pair of cave crawlers near the north trail. Nothing unusual, but they were too close to town."
terminal = true

[sub_resource type="Resource" id="Node_help"]
script = ExtResource("2_node")
node_id = &"help"
speaker_id = &"npc"
speaker_text = "Not on the hunt. You can help by keeping an eye on the road while I'm gone."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"dad_player_talk_casual"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_work"), SubResource("Node_help")])
