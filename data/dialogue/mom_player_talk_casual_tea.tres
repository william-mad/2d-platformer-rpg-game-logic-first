[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://bppyao6kv7shx"]

[ext_resource type="Script" uid="uid://bsmeen4ahl14e" path="res://scripts/resources/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://csithy7k1fddw" path="res://scripts/resources/dialogue/dialogue_node.gd" id="2_node"]
[ext_resource type="Script" uid="uid://cytm50bmpbyao" path="res://scripts/resources/dialogue/dialogue_choice.gd" id="3_choice"]

[sub_resource type="Resource" id="Choice_stay"]
script = ExtResource("3_choice")
choice_id = &"stay_a_while"
text = "Stay and talk a while."
next_node_id = &"stay"

[sub_resource type="Resource" id="Choice_busy"]
script = ExtResource("3_choice")
choice_id = &"just_passing"
text = "Say you were just passing by."
next_node_id = &"busy"

[sub_resource type="Resource" id="Node_entry"]
script = ExtResource("2_node")
node_id = &"entry"
speaker_id = &"mom"
speaker_text = "I was just taking a quiet minute. It's nice to see you."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_stay"), SubResource("Choice_busy")])

[sub_resource type="Resource" id="Node_stay"]
script = ExtResource("2_node")
node_id = &"stay"
speaker_id = &"mom"
speaker_text = "Stay for a while. I could use the company."
terminal = true

[sub_resource type="Resource" id="Node_busy"]
script = ExtResource("2_node")
node_id = &"busy"
speaker_id = &"mom"
speaker_text = "All right. I'm glad you stopped, even if it was only for a minute."
terminal = true

[resource]
script = ExtResource("1_definition")
dialogue_id = &"mom_player_talk_casual_tea"
entry_node_id = &"entry"
nodes = Array[ExtResource("2_node")]([SubResource("Node_entry"), SubResource("Node_stay"), SubResource("Node_busy")])
