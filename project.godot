; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2d platformer rpg game logic first"
run/main_scene="res://scenes/levels/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/app_icon_heart_generated.png"

[autoload]

GameplayFlow="*res://scripts/systems/gameplay_flow.gd"
DialogueController="*res://scripts/systems/dialogue_controller.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
GameSettings="*res://scripts/systems/game_settings.gd"
DamageEvents="*res://scripts/systems/damage_events.gd"
EventBus="*res://scripts/systems/event_bus.gd"
ProgressionSystem="*res://scripts/progression/progression_system.gd"
SceneLoader="*res://scripts/systems/scene_loader.gd"
PauseSystem="*res://scripts/systems/pause_system.gd"
WorldTime="*res://scripts/systems/world_time.gd"
MorningBirds="*res://scenes/instances/morning_birds.tscn"
NightCrickets="*res://scenes/instances/night_crickets.tscn"
NpcMemoryRuntimeRepository="*res://scripts/systems/npc_behavior/npc_memory_runtime_repository.gd"
Relationships="*res://scripts/systems/relationships.gd"
NpcSceneRoutes="*res://scripts/systems/npc_scene_route_manager.gd"
NpcLocations="*res://scripts/systems/npc_locations.gd"
NpcWorldSimulation="*res://scripts/systems/npc_world_simulation.gd"
PlayerHud="*uid://dicudb0t1rd0j"
DebugClockHud="*res://scripts/systems/debug_clock_hud.gd"
PerformanceWatchdog="*res://scripts/systems/performance_watchdog.gd"
GameOverScreen="*res://scripts/systems/game_over_screen.gd"
PlayerRuntime="*res://scripts/systems/player_runtime.gd"

[display]

window/size/viewport_width=754
window/size/viewport_height=496
window/size/mode=4
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[global_group]

attack_target=""
player=""
rope_attachable=""
saveable=""
training_dummy=""

[gui]

theme/custom="res://ui/themes/sunlit_village_theme.tres"

