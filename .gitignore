# Godot 4+ specific ignores
.godot/
.nomedia

# Editor crash recovery temp files (e.g. player.tscn<digits>.tmp)
*.tmp

# Runtime log artifacts
performance_watchdog.log

# Reserved device-name file accidentally created by shell redirects on Windows
nul

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
